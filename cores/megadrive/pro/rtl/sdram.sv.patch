--- a/rtl/sdram.sv
+++ b/rtl/sdram.sv
@@ -22,10 +22,10 @@
 (
 
 	// interface to the MT48LC16M16 chip
-	inout  reg [15:0] SDRAM_DQ,   // 16 bit bidirectional data bus
+	inout  wire [15:0] SDRAM_DQ,  // Retro25: wire + Tri-State unten (Quartus Pro 13386)
 	output reg [12:0] SDRAM_A,    // 13 bit multiplexed address bus
-	output reg        SDRAM_DQML, // byte mask
-	output reg        SDRAM_DQMH, // byte mask
+	output wire       SDRAM_DQML, // byte mask (Retro25: wire, per assign)
+	output wire       SDRAM_DQMH, // byte mask
 	output reg  [1:0] SDRAM_BA,   // two banks
 	output            SDRAM_nCS,  // a single chip select
 	output reg        SDRAM_nWE,  // write enable
@@ -66,6 +66,14 @@
 assign SDRAM_nCS = 0;
 assign SDRAM_CKE = 1;
 assign {SDRAM_DQMH,SDRAM_DQML} = SDRAM_A[12:11];
+
+// Retro25: Quartus Pro erlaubt keine prozedurale Zuweisung an einen inout-
+// Port (13386). Gleiches Verhalten: Datenregister + Freigaberegister, Tri-State
+// hier (wie cores/nes/pro/rtl/sdram.sv). preserve: Die I/O-Zelle jedes Pins
+// braucht ihr eigenes Datenregister, auch wenn Bits gleich sind (24873).
+(* preserve *) reg [15:0] dq_out;
+reg        dq_oe = 0;
+assign SDRAM_DQ = dq_oe ? dq_out : 16'bZ;
 
 localparam RASCAS_DELAY   = 3'd2; // tRCD=20ns -> 2 cycles@85MHz
 localparam BURST_LENGTH   = 3'd0; // 0=1, 1=2, 2=4, 3=8, 7=full page
@@ -183,7 +191,7 @@
 initial reset=5'h1f;
 
 always @(posedge clk) begin
-	reg init_old=0;
+	reg init_old;   // Retro25: Startwert 0 entfernt (Quartus Pro 16754: sonst jeden Takt 0)
 	init_old <= init;
 
 	if(init_old & ~init) reset <= 5'h1f;
@@ -211,10 +219,13 @@
 always @(posedge clk) begin
 	if(state == STATE_START) SDRAM_BA <= (mode == MODE_NORMAL) ? ba : 2'b00;
 
-	SDRAM_DQ <= 'Z;
+	dq_oe <= 1'b0;
+	// Retro25: Datenregister ohne Clock-Enable (in jedem Takt geladen), damit es
+	// mit dq_oe in die I/O-Zelle passt (14996/24403). Am Pin wirkt es nur mit dq_oe.
+	dq_out <= data;
 	casex({active,we,mode,state})
 		{2'bXX, MODE_NORMAL, STATE_START}: {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= active ? CMD_ACTIVE : CMD_AUTO_REFRESH;
-		{2'b11, MODE_NORMAL, STATE_CONT }: {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE, SDRAM_DQ} <= {CMD_WRITE, data};
+		{2'b11, MODE_NORMAL, STATE_CONT }: begin {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_WRITE; dq_oe <= 1'b1; end
 		{2'b10, MODE_NORMAL, STATE_CONT }: {SDRAM_nRAS, SDRAM_nCAS, SDRAM_nWE} <= CMD_READ;
 
 		// init
@@ -235,29 +246,9 @@
 	else SDRAM_A <= 0;
 end
 
-altddio_out
-#(
-	.extend_oe_disable("OFF"),
-	.intended_device_family("Cyclone V"),
-	.invert_output("OFF"),
-	.lpm_hint("UNUSED"),
-	.lpm_type("altddio_out"),
-	.oe_reg("UNREGISTERED"),
-	.power_up_high("OFF"),
-	.width(1)
-)
-sdramclk_ddr
-(
-	.datain_h(1'b0),
-	.datain_l(1'b1),
-	.outclock(clk),
-	.dataout(SDRAM_CLK),
-	.aclr(1'b0),
-	.aset(1'b0),
-	.oe(1'b1),
-	.outclocken(1'b1),
-	.sclr(1'b0),
-	.sset(1'b0)
-);
+// Retro25: SDRAM_CLK entsteht in pro/MegaDrive.sv (PLL-Ausgang mit Phase über
+// sdram_clk_ddio, wie NES/C64/z486); der invertierte Takt (altddio_out,
+// Cyclone V, Fehler 287078) passt nicht zum 1,8-V-SDRAM des DE25.
+assign SDRAM_CLK = 1'b0;
 
 endmodule
