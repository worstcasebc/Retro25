# z486-CPU allein für den A5EB013 (P5/Z2, Synthese-Probelauf) — erzeugt von
# cores/z486/make_pro.py, nicht von Hand ändern.
# Ohne x87 (ENABLE_X87 = 0); alle Ports außer dem Takt als virtuelle Pins:
# der Entwurf wird vollständig platziert und geroutet und liefert echte
# ALM-/M20K-Zahlen und fmax.
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY z486
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SEARCH_PATH ../pro/src/z486
set_global_assignment -name SEARCH_PATH ../vendor/src/z486
set_global_assignment -name SEARCH_PATH ../vendor/src/z486/x87
set_global_assignment -name SEARCH_PATH ../vendor/src
set_global_assignment -name SDC_FILE z486_cpu.sdc
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
# .v-Dateien mit SystemVerilog-Syntax, wie in sys_de25.tcl (MiSTer sys.tcl)
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
# Eine Übersetzungseinheit für alle Dateien: Makros (Include-Guard der
# angepassten z486_platform.svh) gelten dateiübergreifend
set_global_assignment -name VERILOG_CU_MODE MFCU
set_instance_assignment -name VIRTUAL_PIN ON -to *
set_instance_assignment -name VIRTUAL_PIN OFF -to clk
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/z486_platform.svh
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/z486_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_ucode_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/address_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/alu_alt.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/bus_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/cache_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/cpu_throttle.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/data_access.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/data_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/dsp_mul.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/event_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/hardwired_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/interrupt_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/l1_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/l1_icache.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/microsequencer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/mul_div.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/paging_tlb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/paging_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/paging_walker.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/prefetch.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/protection.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/segmentation_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/shifter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/ucode_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/x87/x87_command_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_executor.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/x87/x87_logexp_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_sequencer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/x87/x87_stack_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_transfer_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/x87/x87_ucode_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/z486.sv
