# z486-PC ohne MiSTer-Rahmen (Modul system: CPU, VGA, Sound, IDE …) für den A5EB013 (P5/Z2, Synthese-Probelauf) — erzeugt von
# cores/z486/make_pro.py, nicht von Hand ändern.
# Ohne x87 (ENABLE_X87 = 0); alle Ports außer dem Takt als virtuelle Pins:
# der Entwurf wird vollständig platziert und geroutet und liefert echte
# ALM-/M20K-Zahlen und fmax.
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name TOP_LEVEL_ENTITY system
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SEARCH_PATH ../pro/src/z486
set_global_assignment -name SEARCH_PATH ../vendor/src/z486
set_global_assignment -name SEARCH_PATH ../vendor/src/z486/x87
set_global_assignment -name SEARCH_PATH ../vendor/src
set_global_assignment -name SDC_FILE z486_sys.sdc
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
# .v-Dateien mit SystemVerilog-Syntax, wie in sys_de25.tcl (MiSTer sys.tcl)
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
# Eine Übersetzungseinheit für alle Dateien: Makros (Include-Guard der
# angepassten z486_platform.svh) gelten dateiübergreifend
set_global_assignment -name VERILOG_CU_MODE MFCU
set_instance_assignment -name VIRTUAL_PIN ON -to *
set_instance_assignment -name VIRTUAL_PIN OFF -to clk_sys
set_parameter -name SYS_FREQ 85000000
set_parameter -name DCACHE_SET_BITS 7
set_parameter -name ICACHE_SET_BITS 7
set_parameter -name DCACHE_LINE_WRAP 1
set_parameter -name ENABLE_X87 0
set_parameter -name ENABLE_CMS 0
set_parameter -name ENABLE_VOODOO 0
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/z486_platform.svh
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/z486_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../vendor/src/z486/x87/x87_ucode_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../pro/src/z486/address_unit.sv
