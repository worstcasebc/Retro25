--- a/memtest.sv
+++ b/memtest.sv
@@ -90,12 +90,33 @@ hps_io #(.CONF_STR(CONF_STR)) hps_io
 ///////////////////////////////////////////////////////////////////
 wire clk_ram, locked;
 
-pll pll
+// Retro25: feste Agilex-IOPLL statt der zur Laufzeit umstellbaren Cyclone-V-
+// PLL (Regel in Retro25: nur sys stellt zur Laufzeit eine PLL um — zwei
+// umgestellte HVIO-PLLs stören sich). 64 MHz wie clk64 des C64; die Tasten
+// zum Umstellen und der Automatikmodus wirken nicht mehr.
+//
+// SDRAM-Takt: zweiter PLL-Ausgang, 64 MHz mit +90 Grad, über das DDIO-
+// Register im I/O-Block unverändert zum Pin (din 2'b10) — so laufen Takt und
+// Adressen/Daten (FAST_*_REGISTER in sys_de25.tcl) gleich weit durch den
+// I/O-Block. MiSTers invertierter Takt (180 Grad) passt hier nicht: Mit dem
+// 1,8-V-SDRAM des DE25 kommen die Lesedaten später als bei MiSTer. Gemessen
+// bei 64 MHz (P4): 45/90/135 Grad fehlerfrei, 0/180/270 Grad fast jeder
+// Lesewert falsch (Details in ../README.md).
+wire clk_sdram;
+pll_memtest pll
 (
-	.*,
 	.refclk(CLK_50M),
-	.rst(pll_reset | RESET),
-	.outclk_0(clk_ram)
+	.rst(RESET),
+	.outclk_0(clk_ram),
+	.outclk_1(clk_sdram),
+	.locked(locked)
+);
+
+sdram_clk_ddio sdramclk_ddr
+(
+	.ck(clk_sdram),
+	.din(2'b10),        // din[1] bei clk high, din[0] bei clk low: Takt 1:1
+	.pad_out(SDRAM_CLK)
 );
 
 wire        mgmt_waitrequest;
@@ -105,14 +126,9 @@ reg  [31:0] mgmt_writedata;
 wire [63:0] reconfig_to_pll;
 wire [63:0] reconfig_from_pll;
 
