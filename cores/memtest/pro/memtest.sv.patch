-(
-	.*,
-	.mgmt_clk(CLK_50M),
-	.mgmt_reset(RESET),
-	.mgmt_read(0),
-	.mgmt_readdata()
-);
+// Retro25: keine PLL-Umstellung (siehe oben); die Schreibfolge unten läuft
+// ins Leere und ist sofort fertig.
+assign mgmt_waitrequest = 1'b0;
 
 reg recfg = 0;
 reg pll_reset = 0;
@@ -190,11 +206,14 @@ reg  [15:0] mins = 0;
 reg  [15:0] secs = 0;
