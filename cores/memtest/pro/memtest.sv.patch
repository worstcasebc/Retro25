+reg  [7:0] state = 0;
+integer    min = 0, sec = 0;
+reg        old_stb = 0;
+reg [15:0] old_joy = 0;
+
 always @(posedge CLK_50M) begin
-	reg  [7:0] state = 0;
-	integer    min = 0, sec = 0;
-	reg        old_stb = 0;
-	reg [15:0] old_joy = 0;
 
 	mgmt_write <= 0;
 
@@ -326,7 +345,7 @@ always @(posedge CLK_50M) begin
 		end
 	end
 
