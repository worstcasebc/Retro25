--- a/sdram.v
+++ b/sdram.v
@@ -61,7 +61,7 @@ module sdram
 	output            DRAM_CS_N,
 	output            DRAM_BA_0,
 	output            DRAM_BA_1,
-	inout  reg [15:0] DRAM_DQ,
+	inout  wire [15:0] DRAM_DQ,   // Retro25: wire + Tri-State (Pro: Fehler 13386)
 	output     [12:0] DRAM_ADDR
 );
 
@@ -110,10 +110,15 @@ end
 
 reg [2:0] state;
 reg       wr,rd,wr2,done2;
+// Retro25: Startwert aus dem always-Block geholt (Quartus-Pro-Falle 16754)
+reg  [5:0] rcnt = 0;
+// Retro25: Datenbus als Tri-State (inout reg mag Quartus Pro nicht)
+reg [15:0] dq_out;
+reg        dq_oe = 1'b0;
+assign DRAM_DQ = dq_oe ? dq_out : 16'bZ;
 always @ (posedge clk) begin
 	reg  [9:0] cas_addr, cas_addr2;
 	reg [23:0] addr, addr2, addr3; // x4
-	reg  [5:0] rcnt = 0;
 	reg        rnw_reg;
 	reg  [1:0] rfsh;
 	reg [15:0] rdat2,rdat3;
@@ -127,11 +132,13 @@ always @ (posedge clk) begin
 	st    <= st + 1'd1;
 	state <= st;
 
-	DRAM_DQ <= 16'bZ;
+	dq_oe <= wdat_req;
 
 	wr <= wr2;
 	wdat_req <= wr2 & ready2;
-	if(wdat_req) DRAM_DQ <= wdat;
+	// Retro25: ohne Clock-Enable, damit dq_out und dq_oe in die I/O-Zelle passen
+	// (beide teilen sich dort ein Enable); am Pin wirkt dq_out nur mit dq_oe.
+	dq_out <= wdat;
 
 	rdat3   <= DRAM_DQ;
 	rdat2   <= rdat3;
@@ -247,29 +254,8 @@ always @ (posedge clk) begin
 	done <= done2;
 end
 
-altddio_out
-#(
-	.extend_oe_disable("OFF"),
-	.intended_device_family("Cyclone V"),
-	.invert_output("OFF"),
-	.lpm_hint("UNUSED"),
-	.lpm_type("altddio_out"),
-	.oe_reg("UNREGISTERED"),
-	.power_up_high("OFF"),
-	.width(1)
-)
-sdramclk_ddr
-(
-	.datain_h(1'b0),
-	.datain_l(1'b1),
-	.outclock(clk),
-	.dataout(DRAM_CLK),
-	.aclr(1'b0),
-	.aset(1'b0),
-	.oe(1'b1),
-	.outclocken(1'b1),
-	.sclr(1'b0),
-	.sset(1'b0)
-);
+// Retro25: altddio_out gibt es auf Agilex 5 nicht; den SDRAM-Takt erzeugt
+// memtest.sv (PLL-Ausgang mit Phase über sdram_clk_ddio). Ausgang unbenutzt.
+assign DRAM_CLK = 1'b0;
 
 endmodule
