+	// Retro25 (DE25): die Agilex-5-IOPLL ist immer ganzzahlig, es gibt
+	// keinen fraktionalen Modus, dem man ausweichen könnte.
+	(void)Fout;
+	return false;
+
 	uint32_t c, m;
 	double ko;
 
