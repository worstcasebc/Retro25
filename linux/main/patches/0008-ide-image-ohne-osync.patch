+// Retro25: Images ohne O_SYNC. Mit O_SYNC wartete jeder IDE-Schreibbefehl
+// (oft nur ein Sektor) auf den Datenträger: Stick und SD-Karte schaffen so
+// ~150 Schreibvorgänge/s, Windows 95 schrieb mit ~40 KB/s. Jetzt sammelt
+// Linux die Daten; ide_img_sync_poll() schreibt sie per fsync() auf den
+// Datenträger, sobald 1 s lang nichts mehr geschrieben wurde.
+#define IMG_SYNC_MAX 8
+static fileTYPE *img_sync_file[IMG_SYNC_MAX] = {};
+static bool img_dirty = false;
+static unsigned long img_sync_timer = 0;
+
+static void img_sync_file_now(fileTYPE *f)
+{
+	if (f->filp && !fflush(f->filp)) fsync(fileno(f->filp));
+}
+
+static void img_sync_forget(fileTYPE *f)
+{
+	for (int i = 0; i < IMG_SYNC_MAX; i++)
+	{
+		if (img_sync_file[i] == f)
+		{
+			img_sync_file_now(f);
+			img_sync_file[i] = 0;
+		}
+	}
+}
+
+static void img_sync_track(fileTYPE *f)
+{
+	for (int i = 0; i < IMG_SYNC_MAX; i++)
+	{
+		if (!img_sync_file[i])
+		{
+			img_sync_file[i] = f;
+			return;
+		}
+	}
+	printf("ide_img_mount: no sync slot for %s\n", f->path);
+}
+
+void ide_img_written()
+{
+	img_dirty = true;
+	img_sync_timer = GetTimer(1000);
+}
+
+void ide_img_sync_poll()
+{
+	if (!img_dirty || !CheckTimer(img_sync_timer)) return;
+	img_dirty = false;
+	for (int i = 0; i < IMG_SYNC_MAX; i++)
+	{
+		if (img_sync_file[i]) img_sync_file_now(img_sync_file[i]);
+	}
+}
+
 int ide_img_mount(fileTYPE *f, const char *name, int rw)
 {
+	img_sync_forget(f);
 	FileClose(f);
 	int writable = 0, ret = 0;
 
