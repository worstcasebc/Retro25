+reg [11:0] sz_hcnt = 0, sz_vcnt = 0;
 always @(posedge CLK_VIDEO) begin
-	reg [11:0] hcnt = 0, vcnt = 0;
 	reg old_vs, old_de;
 
 	if(CE_PIXEL) begin
 		old_vs <= VGA_VS;
